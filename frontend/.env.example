# Copy to .env and fill in. .env is git-ignored; never commit real values.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The PUBLISHABLE (anon) key only. Never the service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# "true" shows "Continue with Google" (set up the provider first, see README)
VITE_AUTH_GOOGLE=false
